# Build output
target/
*.class

# Test output
test-output/
test-results/

# Sensitive local config (never commit real credentials)
parameters/system.properties

# IDE files
.idea/
*.iml
*.iws
*.ipr
.eclipse/
.classpath
.project
.settings/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Mobile build artifacts
*.apk
*.ipa
*.aab

# Baseline scratch space. Baseline.record() writes a fingerprint here and
# promote() moves it up into baselines/ only once the test that recorded it
# passes; discard() deletes it when the test fails. A file left behind is an
# interrupted run, named by test key rather than by page object. The promoted
# baselines themselves ARE committed — that is the point of them.
src/main/resources/baselines/pending/
